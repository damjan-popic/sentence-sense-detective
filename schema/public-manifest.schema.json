{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sentence-sense-detective/public-manifest.schema.json",
  "title": "Sentence Sense Detective public question manifest",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "language",
    "version",
    "corpus_version",
    "build_timestamp_utc",
    "round_size",
    "scoring",
    "sampling_policy",
    "modes",
    "totals",
    "gold",
    "shards"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "build_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "round_size": {
      "const": 10
    },
    "scoring": {
      "type": "object"
    },
    "sampling_policy": {
      "type": "object",
      "required": [
        "reviewed_item_weight",
        "recent_question_ids_per_mode",
        "recent_sentence_ids_per_mode",
        "difficulty"
      ],
      "properties": {
        "reviewed_item_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recent_question_ids_per_mode": {
          "type": "integer",
          "maximum": 250
        },
        "recent_sentence_ids_per_mode": {
          "type": "integer",
          "maximum": 150
        },
        "difficulty": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "report_issue_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "totals": {
      "type": "object",
      "required": [
        "sentences",
        "corpus_sentences",
        "questions",
        "reviewed_questions",
        "by_mode",
        "by_subskill",
        "by_difficulty",
        "by_source_corpus"
      ]
    },
    "gold": {
      "$ref": "#/$defs/file"
    },
    "shards": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/file"
          },
          {
            "type": "object",
            "required": [
              "id",
              "mode",
              "difficulty"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "count",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sentence-sense-detective/source.schema.json",
  "title": "Sentence Sense Detective source declaration",
  "type": "object",
  "required": [
    "id",
    "language",
    "title",
    "licence",
    "attribution",
    "rights_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "rights_status": {
      "enum": [
        "cleared-for-publication",
        "rights-pending",
        "blocked"
      ]
    }
  },
  "additionalProperties": false
}

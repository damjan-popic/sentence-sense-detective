{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sentence-sense-detective/question.schema.json",
  "title": "Sentence Sense Detective internal question",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "sentence_id",
    "annotation_id",
    "language",
    "mode",
    "subskill",
    "prompt",
    "answer",
    "options",
    "explanation",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "sentence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "mode": {
      "enum": [
        "parts-of-speech",
        "sentence-elements",
        "clauses"
      ]
    },
    "subskill": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "teacher-reviewed",
        "provisional"
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sentence-sense-detective/public-shard.schema.json",
  "title": "Sentence Sense Detective public question shard",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "mode",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "mode": {
      "enum": [
        "parts-of-speech",
        "sentence-elements",
        "clauses"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sentence_id",
          "language",
          "mode",
          "subskill",
          "sentence",
          "target_spans",
          "prompt",
          "answer",
          "options",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sentence_id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "mode": {
            "enum": [
              "parts-of-speech",
              "sentence-elements",
              "clauses"
            ]
          },
          "subskill": {
            "type": "string",
            "minLength": 1
          },
          "sentence": {
            "type": "string",
            "minLength": 1
          },
          "target_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
